/* pages/login/login.wxss */

.avatar-wrapper {
    padding: 0;
    width: 56px !important;
    border-radius: 8px;
    margin-top: 40px;
    margin-bottom: 40px;
  }
  
  .avatar {
    display: block;
    width: 56px;
    height: 56px;
  }

  .nickname-wrapper {
    display: flex;
    width: 100%;
    padding: 16px;
    box-sizing: border-box;
    border-top: .5px solid rgba(0, 0, 0, 0.1);
    border-bottom: .5px solid rgba(0, 0, 0, 0.1);
    color: black;
  }
  
  .nickname-label {
    width: 105px;
  }
  
  .nickname-input {
    flex: 1;
  }

  .container {
    margin-top: 100rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 50rpx;
  }
  
  .phone-btn {
    margin-top: 100rpx;
    width: 90%;
    height: 80rpx;
    background-color: #07c160;
    color: #fff;
    border-radius: 40rpx;
    font-size: 28rpx;
    display: flex;
    justify-content: center;
    align-items: center;
  }
