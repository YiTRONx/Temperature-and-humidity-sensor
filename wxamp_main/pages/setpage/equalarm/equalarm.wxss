/* pages/setpage/equalarm/equalarm.wxss */
.threshold-section-up {
    margin: 20rpx 20rpx;
    border-bottom: solid 1rpx #666;
  }
  .threshold-section-bottom {
    margin: 0rpx 20rpx;

  }
  .section-title {
    font-size: 32rpx;
    color: #333;
    margin-bottom: 20rpx;
    font-weight: 500;
  }
  .slider-container {
    padding: 0 20rpx;
  }
  .slider-label {
    font-size: 28rpx;
    color: #666;
    margin-bottom: 16rpx;
  }
  .slider-track {
    position: relative;
    height: 16rpx;
    background-color: #e5e5e5;
    border-radius: 8rpx;
    margin: 40rpx 0;
  }
  .slider-selected {
    position: absolute;
    height: 100%;
    background-color: #07c160;
    border-radius: 8rpx;
  }
  .slider-handle {
    position: absolute;
    top: 50%;
    width: 40rpx;
    height: 40rpx;
    background-color: #fff;
    border: 2rpx solid #07c160;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
    z-index: 10;
  }
  