/* pages/chartPage/chartPage.wxss */
.container {
    padding: 20rpx;
    background-color: #f5f5f5;
  }
  
  .chart-card {
    background-color: #fff;
    border-radius: 16rpx;
    padding: 20rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
    width:650rpx;
  }
  
  .chart-title {
    font-size: 28rpx;
    font-weight: 500;
    margin-bottom: 15rpx;
    color: #333;
  }
  
  .chart-canvas {
    /* width: 100%; */
    height: 300rpx;
    width: 600rpx;
    margin-bottom: 15rpx;
  }
  
  .chart-controls {
    display: flex;
    justify-content: center;
    gap: 15rpx;
  }
  
  .chart-controls button {
    padding: 8rpx 20rpx;
    font-size: 24rpx;
    border-radius: 20rpx;
    background-color: #f0f0f0;
    color: #666;
  }
  
  .chart-controls button.active {
    background-color: #07c160;
    color: #fff;
  }