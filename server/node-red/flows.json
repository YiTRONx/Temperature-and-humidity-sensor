    {
        "id": "d4f7e2c1b8d90a3f",
        "type": "function",
        "z": "36146196343219f9",
        "name": "读取日期列表",
        "func": "// 获取 UUID 参数\nconst params = msg.req.query || {};\nconst UUID = params.UUID;\nnode.warn(\"请求数据 \" + params.UUID);\n\n// 无UUID直接返回空数组\nif (!UUID) {\n    msg.payload = [];\n    return msg;\n}\n\n// ====================== 【必填】你的数据存储根目录 ======================\n// Windows系统写法 示例：D:/sensor_data/  结尾必须加 /\n// 匹配你的格式： 根目录/UUID/日期.csv\nconst BASE_PATH = \"C:/User/Administrator/Documents/mqttdata/\";\n// ======================================================================\n\n// 拼接完整文件夹路径\nconst targetPath = BASE_PATH + UUID;\nnode.warn(\"获取完整路径 \" + targetPath);\n\n// 调用系统原生文件模块\nconst fs = global.get(\"fs\");\nlet dateList = [];\n\ntry {\n    // 读取文件夹\n    const files = fs.readdirSync(targetPath);\n    // 筛选CSV文件并提取日期\n    dateList = files\n        .filter(file => file.endsWith('.csv'))\n        .map(file => file.replace('.csv', ''))\n        .sort().reverse(); // 日期排序\n} catch (error) {\n    // 文件夹不存在/无权限 → 返回空数组，不报错\n    dateList = [];\n}\n\nmsg.payload = dateList;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
