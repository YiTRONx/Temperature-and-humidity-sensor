    {
        "id": "24cd5eae8839b4eb",
        "type": "function",
        "z": "36146196343219f9",
        "name": "function-setcsv",
        "func": "// 1. 兼容性处理：判断 payload 是对象还是字符串\nlet data;\nif (typeof msg.payload === 'object') {\n    data = msg.payload;\n} else {\n    try {\n        data = JSON.parse(msg.payload);\n    } catch (e) {\n        node.warn(\"JSON解析失败: \" + msg.payload);\n        return null; // 终止流程，防止报错\n    }\n}\n\n// 2. 检查数据里有没有 time 字段\nif (data && data.time) {\n    // 提取日期 (例如 \"2026-02-21\")\n    let dateStr = data.time.split(\" \")[0];\n\n    // 【核心关键】确保这里的路径是虚拟机里真实存在的\n    // 请把 yourname 换成你虚拟机的实际用户名（比如 test 或 ubuntu）\n    msg.filename = \"C:/User/Administrator/Documents/mqttdata/\" + data.UUID + \"/\" + dateStr + \".csv\";\n\n    // 整理成 CSV 格式：时间,温度,湿度\n    msg.payload = data.time + \",\" + data.temp + \",\" + data.humi + \"\\n\";\n\n    // 打印到调试窗口看一眼路径对不对\n    node.warn(\"准备写入数据: \" + msg.payload + msg.filename );\n    //node.warn(\"准备写入数据: \" + msg.payload);\n    return msg;\n} else {\n    node.warn(\"收到数据但缺失 time 字段: \" + JSON.stringify(data));\n    return null;\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
