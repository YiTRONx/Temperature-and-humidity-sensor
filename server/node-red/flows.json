    {
        "id": "check_token",
        "type": "function",
        "z": "36146196343219f9",
        "name": "检查token并拼接URL",
        "func": "const token = global.get(\"wx_access_token\");\nconst expire = global.get(\"wx_token_expire\");\n\nif (!token || Date.now() > expire) {\n    node.error(\"access_token 无效或已过期\");\n    return null;\n}\n\nmsg.url = `https://api.weixin.qq.com/cgi-bin/message/subscribe/send?access_token=${token}`;\nmsg.method = \"POST\";\nmsg.payload = msg.sendPayload;\nreturn msg;",
