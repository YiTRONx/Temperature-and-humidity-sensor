    {
        "id": "cba59eefe8f95239",
        "type": "function",
        "z": "36146196343219f9",
        "name": "保存OpenID",
        "func": "const data = msg.payload;\n\n// 成功拿到openid\nif (data.openid) {\n    // 1. 把openid存到全局变量（你的MQTT通知直接用！）\n    global.set(\"user_openid\", data.openid);\n\n    // 2. 返回给小程序\n    msg.payload = {\n        code: 0,\n        openid: data.openid,\n        msg: \"success\"\n    };\n} else {\n    // 失败返回错误\n    msg.payload = {\n        code: -1,\n        msg: data.errmsg || \"获取失败\"\n    };\n}\nreturn msg;",
