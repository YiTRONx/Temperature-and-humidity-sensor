    {
        "id": "data_mapping",
        "type": "function",
        "z": "36146196343219f9",
        "name": "MQTT数据映射模板",
        "func": "const mqttData = msg.payload;\nconst temp = mqttData.temp;\nconst humi = mqttData.humi;\nconst deviceName = mqttData.Nickname;\nconst alarmType = mqttData.Type;\n\nmsg.templateData = {\n    \"character_string4\": { \"value\": `${temp}℃` },    // 温度\n    \"character_string18\": { \"value\": `${humi}%` },  // 湿度\n    \"thing24\": { \"value\": deviceName },              // 预警来源\n    \"short_thing25\": { \"value\": alarmType }         // 预警类型\n    // \"short_thing25\": { \"value\": \"预警\" }\n};\n\nmsg.templateId = \"80u8sN2gVRBDiM5GApOmYZjYiKAKGWme7YddLpz26CY\";\nmsg.openid = global.get(\"user_openid\");\n\nif (!msg.openid) {\n    node.error(\"用户 openid 未获取\");\n    return null;\n}\n\nmsg.sendPayload = {\n    touser: msg.openid,\n    template_id: msg.templateId,\n    page: \"pages/index/index\",\n    data: msg.templateData\n};\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
